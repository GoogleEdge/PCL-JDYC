<local:MyPageRight
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" x:Class="PageJdycHub"
             d:DesignWidth="800" d:DesignHeight="900">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="联机大厅" x:Name="CardStatus">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock x:Name="LabStatus" Text="正在连接大厅……" FontSize="14" TextWrapping="Wrap" />
                    <local:MyHint x:Name="HintDeps" Margin="0,12,0,0" Text="" Theme="Yellow" Visibility="Collapsed" />
                    <WrapPanel Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnConnect" Text="连接大厅" MinWidth="140" Padding="13,0" Margin="0,0,20,0" Height="35" />
                        <local:MyButton x:Name="BtnRefresh" Text="刷新房间" MinWidth="140" Padding="13,0" Margin="0,0,20,0" Height="35" />
                        <local:MyButton x:Name="BtnDisconnect" Text="断开" MinWidth="140" Padding="13,0" Margin="0,0,20,0" Height="35" ColorType="Red" />
                    </WrapPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="服务器地址" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyTextBox x:Name="TxtServer" Grid.Column="1" MaxLength="200" />
                        <local:MyButton x:Name="BtnSaveServer" Text="保存" Grid.Column="2" MinWidth="80" Padding="13,0" Margin="12,0,0,0" Height="35" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="创建房间" x:Name="CardCreate">
                <StackPanel Margin="25,40,25,20">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="房间名" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyTextBox x:Name="TxtRoomName" Grid.Column="1" MaxLength="20" />
                    </Grid>
                    <TextBlock Text="模式" FontSize="14" Margin="0,0,0,6" />
                    <WrapPanel Margin="0,0,0,10">
                        <local:MyRadioBox x:Name="RadioModeFrp" Text="端口映射（frp，适合开服）" Margin="0,0,18,0" />
                        <local:MyRadioBox x:Name="RadioModeVlan" Text="虚拟局域网（vlan，适合联机游戏）" Margin="0,0,18,0" />
                    </WrapPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="端口" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyTextBox x:Name="TxtLocalPort" Grid.Column="1" MaxLength="5" Text="25565" />
                    </Grid>
                    <local:MyButton x:Name="BtnCreate" Text="创建房间" MinWidth="140" Padding="13,0" Height="35" ColorType="Highlight" HorizontalAlignment="Left" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="房间列表" x:Name="CardRooms">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock x:Name="LabRoomsEmpty" Text="暂无房间，点击“刷新房间”试试。" FontSize="14" />
                    <StackPanel x:Name="PanRooms" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="加入 / 联网" x:Name="CardNet">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock x:Name="LabNetInfo" Text="在房间列表里点一个房间，再点“加入房间”。" FontSize="14" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnJoin" Text="加入房间" MinWidth="140" Padding="13,0" Margin="0,0,20,10" Height="35" />
                        <local:MyButton x:Name="BtnCopyAddr" Text="复制地址" MinWidth="140" Padding="13,0" Margin="0,0,20,10" Height="35" />
                        <local:MyButton x:Name="BtnLeave" Text="离开房间" MinWidth="140" Padding="13,0" Margin="0,0,20,10" Height="35" ColorType="Red" />
                        <local:MyButton x:Name="BtnTestNet" Text="测试外网联通性" MinWidth="140" Padding="13,0" Margin="0,0,20,10" Height="35" ToolTip="向房间的 frp 地址发送 MC 服务器状态检测包，验证外网玩家能否连通。" />
                    </WrapPanel>
                    <TextBlock x:Name="LabTestResult" Text="" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
