<Grid x:Class="MySkin3D"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="200" Height="260" Background="Transparent">
    <Viewport3D x:Name="View">
        <Viewport3D.Camera>
            <PerspectiveCamera Position="0,16,52" LookDirection="0,0,-1" FieldOfView="40" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup>
                    <AmbientLight Color="#FFBFBFBF" />
                    <DirectionalLight Color="White" Direction="-0.5,-0.8,-0.6" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <ModelVisual3D x:Name="ModelView">
            <ModelVisual3D.Transform>
                <Transform3DGroup>
                    <RotateTransform3D CenterX="0" CenterY="16" CenterZ="0">
                        <RotateTransform3D.Rotation>
                            <AxisAngleRotation3D x:Name="RotX" Axis="1,0,0" Angle="8" />
                        </RotateTransform3D.Rotation>
                    </RotateTransform3D>
                    <RotateTransform3D CenterX="0" CenterY="16" CenterZ="0">
                        <RotateTransform3D.Rotation>
                            <AxisAngleRotation3D x:Name="RotY" Axis="0,1,0" Angle="25" />
                        </RotateTransform3D.Rotation>
                    </RotateTransform3D>
                </Transform3DGroup>
            </ModelVisual3D.Transform>
        </ModelVisual3D>
    </Viewport3D>
</Grid>
