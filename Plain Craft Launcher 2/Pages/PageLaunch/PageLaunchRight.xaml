<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:behaviors="clr-namespace:PCL.Controls.Behaviors"
    xmlns:local="clr-namespace:PCL" xmlns:sys="clr-namespace:System;assembly=mscorlib" PanScroll="PanBack">
    <local:MyPageRight.Resources>
        <sys:String x:Key="JdycLogoRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</sys:String>
        <sys:String x:Key="JdycLogoOpenSite">M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z</sys:String>
        <sys:String x:Key="JdycLogoLogout">M17 7L15.59 8.41L18.17 11H8V13H18.17L15.59 15.58L17 17L22 12M4 5H12V3H4C2.9 3 2 3.9 2 5V19C2 20.1 2.9 21 4 21H12V19H4V5Z</sys:String>
        <sys:String x:Key="JdycLogoSkin">M16,21H8A1,1 0 0,1 7,20V12.07L5.7,13.07C5.31,13.46 4.68,13.46 4.29,13.07L1.46,10.29C1.07,9.9 1.07,9.27 1.46,8.88L7.34,3H9C9,4.1 10.34,5 12,5C13.66,5 15,4.1 15,3H16.66L22.54,8.88C22.93,9.27 22.93,9.9 22.54,10.29L19.71,13.12C19.32,13.5 18.69,13.5 18.3,13.12L17,12.12V20A1,1 0 0,1 16,21</sys:String>
        <sys:String x:Key="JdycLogoCape">M14.4,6L14,4H5V21H7V14H12.6L13,16H20V6H14.4Z</sys:String>
        <sys:String x:Key="JdycLogoClear">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</sys:String>
        <sys:String x:Key="JdycLogoUpload">M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z</sys:String>
    </local:MyPageRight.Resources>
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <local:MyHint x:Name="PanHint" RelativeSetup="HintSnapshot" Theme="Blue" CanClose="True" Margin="0,0,0,12"
                          Text="快照版 PCL 包含尚未正式发布的测试功能，仅限赞助者自己使用。&#xa;请不要随意发给其他人，或是用来制作整合包哦！" />
            <local:MyCard Margin="0,8" Title="皮肤站账号">
                <Grid Margin="25,40,25,17">
                    <StackPanel>
                        <TextBlock Name="LabAccountName" Text="未登录皮肤站" FontSize="16" Margin="0,0,0,6" />
                        <TextBlock Name="LabAccountEmail" Text="" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" Margin="0,0,0,6" />
                        <TextBlock Name="LabStudentStatus" Text="" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <local:MyButton x:Name="BtnRefreshAccount" Logo="{StaticResource JdycLogoRefresh}" Text="刷新账号" MinWidth="140" Padding="13,0" Margin="0,0,12,0" Height="35" />
                            <local:MyButton x:Name="BtnOpenSite" Logo="{StaticResource JdycLogoOpenSite}" Text="打开皮肤站" MinWidth="140" Padding="13,0" Margin="0,0,12,0" Height="35" />
                            <local:MyButton x:Name="BtnLogout" Logo="{StaticResource JdycLogoLogout}" Text="退出皮肤站登录" MinWidth="140" Padding="13,0" ColorType="Red" Height="35" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,8" Title="角色与皮肤">
                <Grid Margin="25,40,25,17">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <local:MyComboBox x:Name="ComboPlayer" MinWidth="240" Margin="0,0,0,8" ToolTip="下拉选择角色后，皮肤预览和换肤/披风都针对该角色。" />
                            <TextBlock Text="拖动预览可以旋转查看。" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" TextWrapping="Wrap" />
                        </StackPanel>
                        <local:MySkin3D Grid.Column="2" HorizontalAlignment="Right" x:Name="Skin3D" />
                    </Grid>
                    <StackPanel Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <local:MyButton x:Name="BtnChangeSkin" Logo="{StaticResource JdycLogoSkin}" Text="换皮肤" MinWidth="140" Padding="13,0" Margin="0,0,12,0" Height="35" />
                            <local:MyButton x:Name="BtnChangeCape" Logo="{StaticResource JdycLogoCape}" Text="换披风" MinWidth="140" Padding="13,0" Margin="0,0,12,0" Height="35" />
                            <local:MyButton x:Name="BtnClearTexture" Logo="{StaticResource JdycLogoClear}" Text="清除皮肤/披风" MinWidth="140" Padding="13,0" ColorType="Red" Height="35" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <local:MyButton x:Name="BtnUploadSkin" Logo="{StaticResource JdycLogoUpload}" Text="上传皮肤" MinWidth="140" Padding="13,0" Margin="0,0,12,0" Height="35" ToolTip="选一张 PNG，皮肤宽高须为 64 的倍数 × 32 的倍数；上传后自动设为当前角色的皮肤，仅自己可见，不公开。" />
                            <local:MyButton x:Name="BtnUploadCape" Logo="{StaticResource JdycLogoUpload}" Text="上传披风" MinWidth="140" Padding="13,0" Height="35" ToolTip="选一张 PNG，披风须为 2:1；上传后自动设为当前角色的披风，仅自己可见，不公开。" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,8" Title="启动日志" x:Name="PanLog">
                <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4" IsReadOnly="True" IsUndoEnabled="False"
                         AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" HasBackground="False"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
