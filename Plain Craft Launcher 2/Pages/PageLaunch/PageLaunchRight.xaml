<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:behaviors="clr-namespace:PCL.Controls.Behaviors"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <local:MyHint x:Name="PanHint" RelativeSetup="HintSnapshot" Theme="Blue" CanClose="True" Margin="0,0,0,15"
                          Text="快照版 PCL 包含尚未正式发布的测试功能，仅限赞助者自己使用。&#xa;请不要随意发给其他人，或是用来制作整合包哦！" />
            <local:MyCard Margin="0,15" Title="皮肤站账号">
                <Grid Margin="25,40,25,17">
                    <StackPanel>
                        <TextBlock Name="LabAccountName" Text="未登录皮肤站" FontSize="16" Margin="0,0,0,4" />
                        <TextBlock Name="LabAccountEmail" Text="" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" Margin="0,0,0,4" />
                        <TextBlock Name="LabStudentStatus" Text="" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <local:MyButton x:Name="BtnRefreshAccount" Text="刷新账号" MinWidth="120" Padding="13,0" Margin="0,0,12,0" />
                            <local:MyButton x:Name="BtnOpenSite" Text="打开皮肤站" MinWidth="120" Padding="13,0" Margin="0,0,12,0" />
                            <local:MyButton x:Name="BtnLogout" Text="退出皮肤站登录" MinWidth="140" Padding="13,0" ColorType="Red" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,15" Title="角色与皮肤">
                <Grid Margin="25,40,25,17">
                    <StackPanel>
                        <TextBlock Text="角色（下拉选择后，皮肤预览和换肤/披风都针对该角色）" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" Margin="0,0,0,6" />
                        <local:MyComboBox x:Name="ComboPlayer" MinWidth="240" Margin="0,0,0,10" />
                        <local:MySkin HorizontalAlignment="Left" x:Name="Skin" HasCape="False" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <local:MyButton x:Name="BtnChangeSkin" Text="换皮肤" MinWidth="120" Padding="13,0" Margin="0,0,12,0" />
                            <local:MyButton x:Name="BtnChangeCape" Text="换披风" MinWidth="120" Padding="13,0" Margin="0,0,12,0" />
                            <local:MyButton x:Name="BtnClearTexture" Text="清除皮肤/披风" MinWidth="140" Padding="13,0" ColorType="Red" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <local:MyButton x:Name="BtnUploadSkin" Text="上传皮肤" MinWidth="120" Padding="13,0" Margin="0,0,12,0" />
                            <local:MyButton x:Name="BtnUploadCape" Text="上传披风" MinWidth="120" Padding="13,0" />
                        </StackPanel>
                        <TextBlock Text="上传：选一张 PNG，皮肤宽高须为 64 的倍数 × 32 的倍数，披风须为 2:1；上传后自动设为当前角色的皮肤/披风，仅自己可见，不公开。" FontSize="11" Foreground="{DynamicResource ColorBrushGray3}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,15" Title="登录规则">
                <Grid Margin="25,40,25,17">
                    <StackPanel>
                        <local:MyCheckBox Height="28" Text="允许离线登录（默认关闭）" local:SettingService.Key="JdycAllowOffline" ToolTip="默认关闭：启动页不显示离线选项，正版和我校皮肤站登陆不受影响。打开后离线登录才可用。" />
                        <TextBlock Text="皮肤站登录和正版登录不需要打开离线开关就能用；离线登录只在打开后才出现。" FontSize="11" Foreground="{DynamicResource ColorBrushGray3}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="启动日志" x:Name="PanLog">
                <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4" IsReadOnly="True" IsUndoEnabled="False"
                         AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" HasBackground="False"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
